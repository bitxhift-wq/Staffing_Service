# Public site URL (HTTPS, no trailing slash). Used for canonical URLs, Open Graph, JSON-LD, sitemap and robots.txt.
VITE_SITE_URL=https://smrikaam.com

# Google Search Console HTML-tag verification token (value of the "content" attribute). Leave empty until verified.
VITE_GOOGLE_SITE_VERIFICATION=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Preferred: configure GA4 inside GTM.
VITE_GTM_ID=

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Only used when VITE_GTM_ID is empty.
VITE_GA4_MEASUREMENT_ID=

# Form backend endpoint that accepts a JSON POST (e.g. a Formspree / Getform / own API URL).
# When empty, the enquiry form opens a pre-filled email to the talent desk instead.
VITE_FORM_ENDPOINT=
