lor: var(--near-black);\r\n  flex-shrink: 0;\r\n  width: 56px;\r\n  height: 56px;\r\n  overflow: visible;\r\n}\r\n\r\n.talento-nontech-icon svg {\r\n  display: block;\r\n  width: 34px;\r\n  height: 34px;\r\n  max-width: 100%;\r\n  overflow: visible;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.talento-nontech-text-wrap {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  min-width: 0;\r\n}\r\n\r\n.talento-nontech-title {\r\n  font-family: var(--font-heading);\r\n  font-size: clamp(20px, 1.6vw, 24px);\r\n  font-weight: 800;\r\n  text-transform: uppercase;\r\n  color: var(--black);\r\n  letter-spacing: -0.01em;\r\n  margin: 0;\r\n  line-height: 1.15;\r\n}\r\n\r\n.talento-nontech-statement,\r\n.talento-nontech-content {\r\n  font-family: var(--font-body);\r\n  font-size: 14.5px;\r\n  color: var(--mid-grey);\r\n  line-height: 1.6;\r\n  margin: 0;\r\n}\r\n\r\n.talento-nontech-badge {\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.1em;\r\n  text-transform: uppercase;\r\n  background: var(--black);\r\n  color: var(--white);\r\n  padding: 8px 16px;\r\n  white-space: nowrap;\r\n  flex-shrink: 0;\r\n  display: inline-block;\r\n}\r\n\r\n/* ==========================================================================\r\n   SECTIONS 08 & 09: OFFSHORE TEAM & PAYROLL COMPLIANCE\r\n   ========================================================================== */\r\n.talento-dual-section {\r\n  position: relative;\r\n  overflow: hidden;\r\n  padding: clamp(48px, 5.5vw, 76px) clamp(24px, 4.5vw, 68px);\r\n  background-color: var(--white);\r\n  border-bottom: 1px solid var(--border-grey);\r\n}\r\n\r\n.talento-dual-bg-decor {\r\n  position: absolute;\r\n  inset: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  pointer-events: none;\r\n  z-index: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n.talento-dual-svg {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.talento-dual-grid {\r\n  position: relative;\r\n  z-index