p:hover .talento-model-img {\r\n  transform: scale(1.03);\r\n}\r\n\r\n/* ==========================================================================\r\n   SECTION 06: TECHNOLOGY AREAS WE HIRE FOR (STANDALONE ENTERPRISE REDESIGN)\r\n   ========================================================================== */\r\n.talento-tech-section {\r\n  position: relative;\r\n  overflow: hidden;\r\n  width: 100%;\r\n  box-sizing: border-box;\r\n  scroll-margin-top: 82px;\r\n  min-height: calc(100vh - 82px);\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  padding: clamp(48px, 6vh, 88px) clamp(24px, 4vw, 72px);\r\n  background-color: #ffffff;\r\n  border-bottom: 1px solid var(--border-grey);\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n  text-rendering: optimizeLegibility;\r\n}\r\n\r\n.talento-tech-bg {\r\n  position: absolute;\r\n  inset: 0;\r\n  pointer-events: none;\r\n  overflow: hidden;\r\n  z-index: 1;\r\n}\r\n\r\n/* Modern corporate glass facade building backdrop in upper-right */\r\n.talento-tech-bg-building {\r\n  position: absolute;\r\n  top: 0;\r\n  right: 0;\r\n  width: 52%;\r\n  max-width: 840px;\r\n  height: 60%;\r\n  opacity: 0.94;\r\n  z-index: 1;\r\n  mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.2) 20%, black 55%);\r\n  -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.2) 20%, black 55%);\r\n}\r\n\r\n.talento-tech-building-img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  object-position: right top;\r\n  display: block;\r\n  image-rendering: -webkit-optimize-contrast;\r\n}\r\n\r\n/* Sweeping 3D Metallic/Silver Wave Ribbon Layer */\r\n.talento-tech-ribbon-svg {\r\n  position: absolute;\r\n  top: 0;\r\n  right: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  pointer-events: none;\r\n  z-index: 2;\r\n  shape-rendering: geometricPrecision;\r\n}\r\n\r\n/* Bottom dark smoky curved accent */\r\n.talento-tech-bottom-swoosh {\r\n  position: absolute;\r\n  bottom: 0;\r\n  left: 0;\r\n  right: 0;\r\n  height: 90px;\r\n  background: radial-gradient(ellipse 65% 85px at 74% 100%, rgba(28, 29, 34, 0.75) 0%, rgba(45, 47, 54, 0.3) 45%, transparent 100%);\r\n  z-index: 2;\r\n  pointer-events: none;\r\n}\r\n\r\n.talento-tech-content {\r\n  position: relative;\r\n  z-index: 3;\r\n  max-width: 1560px;\r\n  margin: 0 auto;\r\n  width: 100%;\r\n}\r\n\r\n.talento-tech-header-wrap {\r\n  margin-bottom: clamp(24px, 3vh, 40px);\r\n  text-align: left;\r\n}\r\n\r\n.talento-tech-title {\r\n  font-family: 'Barlow Condensed', var(--font-heading);\r\n  font-size: clamp(40px, 4.4vw, 68px);\r\n  font-weight: 800;\r\n  line-height: 0.96;\r\n  letter-spacing: -0.015em;\r\n  text-transform: uppercase;\r\n  color: var(--black);\r\n  margin: 0 0 10px 0;\r\n}\r\n\r\n.talento-tech-sub {\r\n  font-family: var(--font-body);\r\n  font-size: clamp(14px, 1.05vw, 17px);\r\n  line-height: 1.55;\r\n  color: #44464f;\r\n  margin: 0;\r\n  max-width: 680px;\r\n}\r\n\r\n/* Grid Layout: 4 Columns x 2 Rows */\r\n.talento-tech-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n  grid-auto-rows: 1fr;\r\n  gap: clamp(16px, 1.6vw, 26px);\r\n  align-items: stretch;\r\n}\r\n\r\n/* Base Card Style (White Architectural Theme) - Consistent across ALL 8 Cards */\r\n.talento-tech-card {\r\n  position: relative;\r\n  background: #ffffff;\r\n  border: 1px solid #e1e3e8;\r\n  border-radius: 8px;\r\n  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);\r\n  padding: clamp(22px, 1.8vw, 30px) clamp(20px, 1.6vw, 26px);\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  overflow: hidden;\r\n  height: 100%;\r\n  min-height: clamp(150px, 16vh, 180px);\r\n  box-sizing: border-box;\r\n  cursor: pointer;\r\n  outline: none;\r\n  transition: background-color 0.14s ease,\r\n    border-color 0.14s ease,\r\n    transform 0.25s var(--ease),\r\n    box-shadow 0.25s var(--ease);\r\n  /* Precise architectural chamfer notch on top-left */\r\n  clip-path: polygon(22px 0, 100% 0, 100% 100%, 0 100%, 0 22px);\r\n  -webkit-clip-path: polygon(22px 0, 100% 0, 100% 100%, 0 100%, 0 22px);\r\n}\r\n\r\n/* Hover, Focus, and Active Tap State: Smooth Transition to Black across ALL 8 Cards */\r\n.talento-tech-card:hover,\r\n.talento-tech-card:focus-visible,\r\n.talento-tech-card.is-active {\r\n  transition-delay: 0s !important;\r\n  background-color: #0c0d10;\r\n  border-color: #23252a;\r\n  transform: translateY(-4px);\r\n  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.22), 0 2px 6px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.talento-tech-card-top {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 14px;\r\n}\r\n\r\n/* Architectural Icon Badges */\r\n.talento-tech-icon-badge {\r\n  width: clamp(42px, 3vw, 48px);\r\n  height: clamp(42px, 3vw, 48px);\r\n  border-radius: 7px;\r\n  background: #f4f5f8;\r\n  border: 1px solid #e2e4e9;\r\n  color: #111111;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n  transition: background-color 0.25s var(--ease),\r\n    color 0.25s var(--ease),\r\n    border-color 0.25s var(--ease);\r\n}\r\n\r\n.talento-tech-card:hover .talento-tech-icon-badge,\r\n.talento-tech-card:focus-visible .talento-tech-icon-badge,\r\n.talento-tech-card.is-active .talento-tech-icon-badge {\r\n  background-color: #202228;\r\n  border-color: #383b44;\r\n  color: #ffffff;\r\n}\r\n\r\n.talento-tech-card-num {\r\n  font-family: var(--font-mono);\r\n  font-size: clamp(12px, 0.9vw, 14px);\r\n  color: #7b7d87;\r\n  font-weight: 600;\r\n  letter-spacing: 0.05em;\r\n  transition: color 0.25s var(--ease);\r\n}\r\n\r\n.talento-tech-card:hover .talento-tech-card-num,\r\n.talento-tech-card:focus-visible .talento-tech-card-num,\r\n.talento-tech-card.is-active .talento-tech-card-num {\r\n  color: #9ea1ac;\r\n}\r\n\r\n.talento-tech-card-title {\r\n  font-family: 'Barlow Condensed', var(--font-heading);\r\n  